NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Server-only. Required by the Aemeath read API and owner token CLI.
# Configure this in Vercel, but never use a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Local-only credentials for npm run verify:ledger. Do not add these to Vercel.
LEDGERFLOW_TEST_EMAIL=ledger-test@example.com
LEDGERFLOW_TEST_PASSWORD=replace-with-a-test-user-password

# Optional local/deployed Aemeath contract verification. The generated token
# belongs in Aemeath's environment; do not commit a real value here.
LEDGERFLOW_BASE_URL=http://localhost:3000
LEDGERFLOW_AEMEATH_TOKEN=replace-with-a-generated-integration-token
